<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/list_item_gap"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clickable="true"
    android:focusable="true"
    >
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView_itemDistList_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textView_itemDistList_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:backgroundTint="@color/light_aqua"
            app:cardCornerRadius="10dp"
            >
            <TextView
                android:id="@+id/textView_itemDistList_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="25m"
                android:textSize="@dimen/plain_text_size"
                android:layout_margin="15dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                />
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/textView_itemDistList_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:textAlignment="textStart"
            android:textSize="@dimen/plain_text_size"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/cardView_itemDistList_distance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="@dimen/item_horizontal_padding"
            tools:text="Nombre de ruta muy largoparahacerellipsisssssss"
            />
</androidx.constraintlayout.widget.ConstraintLayout>