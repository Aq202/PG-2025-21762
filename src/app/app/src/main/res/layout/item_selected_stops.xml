<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/item_border_radius"
    android:elevation="@dimen/item_elevation"
    android:layout_marginBottom="@dimen/item_vertical_margin"
    android:layout_marginHorizontal="@dimen/item_horizontal_margin"
    >

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/item_vertical_padding"
    android:layout_marginHorizontal="@dimen/item_horizontal_padding"
    >
    <TextView
        android:id="@+id/textView_selectedStops_stopName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/h5_text_size"
        android:ellipsize="end"
        android:maxLines="2"
        android:singleLine="false"
        android:scrollHorizontally="false"
        tools:text="Santa Mónica"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView_selectedStops_location"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/textView_selectedStops_stopName"
        app:layout_constraintStart_toStartOf="parent"
        app:liteMode="true"
        android:layout_marginTop="15dp"
        android:contentDescription="@string/stop_location_content_desc"
         />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_selectedStops_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/remove"
        android:textStyle="bold"
        android:textSize="@dimen/plain_text_size"
        app:icon="@drawable/ic_delete"
        app:tint="@color/main_color"
        app:iconSize="@dimen/button_icon_size"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeWidth="@dimen/input_stroke_width"
        app:strokeColor="@color/main_color"
        app:cornerRadius="@dimen/input_corner_radius"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/mapView_selectedStops_location"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>