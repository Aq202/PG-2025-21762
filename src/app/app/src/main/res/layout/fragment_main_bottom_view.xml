<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.mainBottomView.MainBottomViewFragment"
    android:paddingVertical="@dimen/fragment_vertical_margin"
    android:paddingHorizontal="@dimen/fragment_horizontal_margin">

    <TextView
        android:id="@+id/textView_mainBottomView_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/nearby_routes"
        android:textSize="@dimen/h2_text_size"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/recyclerView_mainBottomView_routes"
        android:layout_marginBottom="30dp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_mainBottomView_routes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_distance_list"
        app:layout_constraintTop_toBottomOf="@id/textView_mainBottomView_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>




</androidx.constraintlayout.widget.ConstraintLayout>