<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.stopsListView.StopsListFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView_stopsList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/fragment_horizontal_margin"
            android:paddingVertical="@dimen/fragment_vertical_margin">

            <TextView
                android:id="@+id/textview_stopsList_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stops"
                android:textSize="@dimen/h2_text_size"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <Spinner
                android:id="@+id/spinner_stopsList_agencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"
                android:layout_marginTop="@dimen/title_bottom_margin"
                android:paddingVertical="@dimen/spinner_padding_vertical" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView_stopsList_stops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                tools:listitem="@layout/item_stops_list" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_stopsList_newStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/floating_action_button_margin"
        android:textAllCaps="false"
        android:contentDescription="@string/select_stop_content_desc"
        app:icon="@drawable/ic_plus"
        android:backgroundTint="@color/secondary_dark_color"
        app:iconTint="@color/black"
        android:textColor="@color/black"
        style="@style/Widget.MaterialComponents.ExtendedFloatingActionButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>