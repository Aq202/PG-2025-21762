<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="@dimen/item_border_radius"
    android:elevation="@dimen/item_elevation"
    android:layout_marginBottom="@dimen/item_vertical_margin"
    android:layout_marginHorizontal="@dimen/item_horizontal_margin"
    >

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/item_vertical_padding"
    android:layout_marginHorizontal="@dimen/item_horizontal_padding"
    >
    <TextView
        android:id="@+id/textView_stopsList_stopName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/h5_text_size"
        android:ellipsize="end"
        android:maxLines="2"
        android:singleLine="false"
        android:scrollHorizontally="false"
        tools:text="Santa Mónica"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView_stopsList_location"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@id/textView_stopsList_stopName"
        app:layout_constraintStart_toStartOf="parent"
        app:liteMode="true"
        android:layout_marginTop="15dp"
        android:contentDescription="@string/stop_location_content_desc"
         />

</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>