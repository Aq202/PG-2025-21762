<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.routeDetailsBottomView.RouteDetailsBottomView">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView_routeDetails_mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/fragment_vertical_margin"
                android:paddingHorizontal="@dimen/fragment_horizontal_margin"
                android:layout_marginBottom="150dp"
                >

                <View
                    android:id="@+id/view_routeDetails_line"
                    android:layout_width="100dp"
                    android:layout_height="5dp"
                    android:background="@android:color/darker_gray"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <ImageButton
                    android:id="@+id/imageButton_routeDetails_closeButton"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/ic_close"
                    android:background="@null"
                    app:tint="@color/dark_gray"
                    android:contentDescription="@string/close_toolbar_icon"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toBottomOf="@id/view_routeDetails_line"
                    app:layout_constraintEnd_toEndOf="parent"
                    />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/textView_routeDetails_routeName"
                    tools:text="Casa - Universidad"
                    android:textSize="@dimen/h2_text_size"
                    app:layout_constraintTop_toBottomOf="@id/imageButton_routeDetails_closeButton"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="15dp"
                    />

                <com.example.public_transport_app.ui.imageSlider.ImageSliderView
                    android:id="@+id/imageSlider_routeDetails"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/textView_routeDetails_routeName"
                    />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/textview_routeDetails_scheduleTitle"
                    android:text="@string/attention_schedule_title"
                    app:layout_constraintTop_toBottomOf="@id/imageSlider_routeDetails"
                    android:layout_marginTop="30dp"
                    android:textSize="@dimen/h4_text_size"
                    />

                <!-- Monday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_mondayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/textview_routeDetails_scheduleTitle"
                    app:layout_constraintEnd_toStartOf="@id/textView_mondaySchedule"
                    android:backgroundTint="@color/light_gray"
                    android:layout_marginTop="30dp"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/monday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_mondaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:backgroundTint="@color/black"
                    tools:text="12:00 - 21:00"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_mondayLabel"
                    app:layout_constraintStart_toEndOf="@id/cardView_mondayLabel"
                    app:layout_constraintTop_toTopOf="@id/cardView_mondayLabel" />


                <!-- Tuesday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_tuesdayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_mondayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/tuesday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_tuesdaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_tuesdayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_tuesdayLabel" />


                <!-- Wednesday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_wednesdayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_tuesdayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/wednesday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_wednesdaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_wednesdayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_wednesdayLabel" />


                <!-- Thursday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_thursdayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_wednesdayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/thursday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_thursdaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_thursdayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_thursdayLabel" />


                <!-- Friday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_fridayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_thursdayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/friday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_fridaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_fridayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_fridayLabel" />


                <!-- Saturday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_saturdayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_fridayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/saturday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_saturdaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_saturdayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_saturdayLabel" />


                <!-- Sunday -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView_sundayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:layout_constraintTop_toBottomOf="@id/cardView_saturdayLabel"
                    app:layout_constraintStart_toStartOf="@id/cardView_mondayLabel"
                    android:backgroundTint="@color/light_gray"
                    app:contentPaddingLeft="10dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:contentPaddingBottom="5dp"
                    app:cardCornerRadius="10dp"
                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/plain_text_size"
                        android:text="@string/sunday"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/textView_sundaySchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/black"
                    android:hint="@string/time_template"
                    tools:text="--:-- - --:--"
                    app:layout_constraintBottom_toBottomOf="@id/cardView_sundayLabel"
                    app:layout_constraintStart_toStartOf="@id/textView_mondaySchedule"
                    app:layout_constraintTop_toTopOf="@id/cardView_sundayLabel"

                    />




            </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:id="@+id/container_noResultsContent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >

        <ImageView
            android:id="@+id/imageView_routeDetails_noResultsBanner"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:contentDescription="@string/banner_desc_no_results"
            android:src="@drawable/banner_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textView_contactsFragment_noResults"
            app:layout_constraintVertical_chainStyle="packed"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textView_contactsFragment_noResults"
            android:textAlignment="center"
            android:textSize="@dimen/h3_text_size"
            android:layout_marginTop="30dp"
            android:text="@string/no_results_found"
            app:layout_constraintTop_toBottomOf="@id/imageView_routeDetails_noResultsBanner"
            app:layout_constraintBottom_toBottomOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
